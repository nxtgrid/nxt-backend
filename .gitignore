# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Build / compile output (any project depth)
dist/
tmp/
out-tsc/

# Dependencies
node_modules/

# Nx
.nx/

# Test output
coverage/

# Environment & secrets
.env
.env.*
!.env.example
!supabase/.env.example
_NOTES

# Supabase local state (root chain + legacy reference)
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/.env.keys
supabase/.env.local
supabase/.env.*.local
legacy/supabase/.temp/
legacy/supabase/.branches/

# Logs & runtime artifacts
*.log
connect.lock
libpeerconnection.log

# Tooling caches
.sass-cache/
typings/
.cache/

# IDE — VSCode (track shared workspace settings)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IDE — other editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# AI agent local state
.claude/worktrees/
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

test-output
