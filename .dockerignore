supabase/.temp/
supabase/.branches/
supabase/.env
supabase/.env.*
supabase/generated-types.ts

# IDE, tooling caches, OS
.vscode/
.idea/
.cache/
.sass-cache/
.DS_Store
Thumbs.db
*.log

# Docs and plans — not needed at build time
docs/
.cursor/
.claude/

# Docker context meta
Dockerfile
.dockerignore
