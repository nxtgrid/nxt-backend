# Dependencies and build output — reinstalled/rebuilt inside the image.
node_modules/
dist/
tmp/
out-tsc/
coverage/
test-output/

# Nx local cache
.nx/

# Legacy reference tree — excluded from the graph; not needed to build api/worker.
legacy/

# VCS and local env
.git/
.gitignore
.env
.env.*
_NOTES

