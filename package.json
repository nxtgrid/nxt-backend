  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "supabase": "supabase",
    "gen-types-local": "pnpm supabase gen types typescript --local --schema public > supabase/generated-types.ts",
    "gen-better-types": "better-supabase-types -i supabase/generated-types.ts -o libs/core/src/types/supabase-types.ts -s --enumAsType && node supabase/scripts/fix-supabase-json-type.js && eslint --fix libs/core/src/types/supabase-types.ts && rm supabase/generated-types.ts",
    "generate-types:local": "pnpm gen-types-local && pnpm gen-better-types"
  },
  "private": true,
  "devDependencies": {
    "better-supabase-types": "2.7.6",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nx/eslint": "23.0.2",
    "@nx/eslint-plugin": "23.0.2",
    "@nx/jest": "23.0.2",
    "@nx/js": "23.0.2",
    "@nx/nest": "23.0.2",
    "@nx/node": "23.0.2",
    "@nx/web": "23.0.2",
    "@nx/webpack": "23.0.2",
    "@swc/helpers": "~0.5.18",
    "@swc/jest": "~0.2.38",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.0.2",
    "supabase": "2.109.1",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  }
}
