# Host-specific env for `api`.
# Copy to `apps/api/.env`.
#
# Shared secrets (`SUPABASE_URL`, `SUPABASE_SECRET_KEY`, LOG_*, NXT_CONFIG_*) live in
# the repo-root `.env` — see root `.env.example`. Nx merges: this file first, then root
# (first definition wins).

# --- Optional host port -----------------------------------------------------------
# PORT=3000

# --- Auth (wired in Task 7; document now) -----------------------------------------
# Publishable key (replaces legacy anon key) — user-scoped / RLS-exercising clients.
# SUPABASE_PUBLISHABLE_KEY=
#
# Preferred JWT verification for api (asymmetric / JWKS) — Task 7 candidate.
# SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
#
# Legacy HS256 verify fallback (only if still needed during dual-key period).
# SUPABASE_JWT_SECRET=
